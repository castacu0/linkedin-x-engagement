# ----------------------------------------------------------------------------
# linkedin-x-engagement — environment configuration
# Copy this file to `.env` and fill in the values you have. Everything is
# optional: any source without credentials is simply skipped (with a warning),
# so you can wire platforms up one at a time.
# ----------------------------------------------------------------------------

# --- X / Twitter (read posts) -------------------------------------------------
# App-only Bearer Token from the X Developer Portal (Basic tier or higher is
# needed to read user timelines). Used to read recent posts from the X accounts
# listed in config/accounts.json.
X_BEARER_TOKEN=

# --- LinkedIn (read org posts) ------------------------------------------------
# Reading LinkedIn *organization* posts requires the Community Management API,
# an access token, and admin rights on the page. Personal profile feeds are NOT
# available via the public API. For most setups the practical path is to set an
# `rssUrl` per account in config/accounts.json instead (see README).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202406

# --- Comment drafting (Anthropic) --------------------------------------------
# If set, drafts are written by Claude using the "learn-wise" system prompt.
# If unset, a built-in template writer is used as a fallback (lower quality).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Notifications ------------------------------------------------------------
# Optional webhook the scan POSTs its daily summary to. Point this at a
# Make.com / Zapier webhook that fans out to Google Calendar + the Claude app
# (see README → Notifications).
NOTIFY_WEBHOOK_URL=

# --- Scan window --------------------------------------------------------------
# How far back "since yesterday" looks, in hours. Default 24.
SCAN_SINCE_HOURS=24
